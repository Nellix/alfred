# Providers are tried left-to-right. Add custom last for a local final fallback.
LLM_PROVIDER_CHAIN=gemini,openrouter
LLM_PROVIDER=

# Recommended development default: Gemini API free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternative: OpenRouter free-model router.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=Alfred
OPENROUTER_SITE_URL=

# Optional local or other chat-completions-compatible server.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=local
LLM_MODEL=your-model-name
DEVICE_SERIAL=
PORTAL_BASE_URL=http://127.0.0.1:8080
PORTAL_TOKEN=
VISION_FALLBACK_ENABLED=false
RECORD_RAW_SCREENSHOTS=false
SMA_DATABASE=sma.db
